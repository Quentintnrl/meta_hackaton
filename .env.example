# Copy to .env (never commit .env).

# Meta Model API key. Required.
MODEL_API_KEY=""

# Figma personal access token (read access to file content), from the account dedicated to this project,
# which must have the project's Figma file shared with it. Needed to link a Figma frame to a feature.
FIGMA_TOKEN=""

# Instagram, read by the app itself (optional). A professional Instagram account linked to a Facebook Page,
# and a Meta app with the Instagram Graph API. Without these two, you paste the posts on the Platforms page.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
